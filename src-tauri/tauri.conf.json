{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nila Webs",
  "version": "1.5.0",
  "identifier": "com.nilawebs.builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nila Webs",
        "width": 1600,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data: blob:; media-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; font-src 'self' data: https:; frame-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Nila Webs",
    "copyright": "Copyright © 2026 Nila Webs",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "compression": "lzma",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
